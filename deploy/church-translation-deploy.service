[Unit]
Description=Deploy verified Church Translation release
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
Environment=REPO_DIR=/root/FOCUS-translation
Environment=ENV_FILE=/root/FOCUS-translation/.env
ExecStart=/root/FOCUS-translation/deploy/deploy.sh
Nice=10

[Install]
WantedBy=multi-user.target